{
  "Serilog": {
    "ApplicationName": "api-gateway",
    "ElasticsearchUri": "http://localhost:19200",
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "BuyEZIdentityRoute": {
        "ClusterId": "BuyEZIdentityCluster",
        "Match": {
          "Path": "v1/api/identities/{**catch-all}"
        }
      },
      "BuyEZCatalogRoute": {
        "ClusterId": "BuyEZCatalogCluster",
        "Match": {
          "Path": "/v1/api/catalogs/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/v1/api/catalogs" },
          { "PathPrefix": "/v1/api/product-shoppings" }
        ]
      },
      "BuyEZCatalogAdminRoute": {
        "ClusterId": "BuyEZCatalogCluster",
        "Match": {
          "Path": "/v1/api/admin/catalogs/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/v1/api/admin/catalogs" },
          { "PathPrefix": "/v1/api/product-administrations" }
        ]
      },
      "BuyEZClientManagementAdminRoute": {
        "ClusterId": "BuyEZClientManagementCluster",
        "Match": {
          "Path": "v1/api/admin/clients/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "v1/api/admin/clients" },
          { "PathPrefix": "/v1/api/client-administrations" }
        ]
      },
      "BuyEZOrderRoute": {
        "ClusterId": "BuyEZOrderCluster",
        "Match": {
          "Path": "v1/api/orders/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "v1/api/orders" },
          { "PathPrefix": "/v1/api/order-shoppings" }
        ]
      }
    },
    "Clusters": {
      "BuyEZIdentityCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5105"
          }
        }
      },
      "BuyEZCatalogCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5205"
          }
        }
      },
      "BuyEZClientManagementCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5305"
          }
        }
      },
      "BuyEZOrderCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5405"
          }
        }
      }
    }
  }
}
