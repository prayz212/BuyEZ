{
  "Serilog": {
    "ApplicationName": "shipping-worker",
    "ElasticsearchUri": "http://localhost:19200",
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=BuyEZ-Shipping;Port=5432;User Id =postgres;Password=postgres;"
  },
  "JobCronOptions": {
    "FindDriver": "0 * * ? * *",
    "PickUpOrder": "0 */10 * ? * *",
    "DeliverOrder": "0 */30 * ? * *"
  }
}
