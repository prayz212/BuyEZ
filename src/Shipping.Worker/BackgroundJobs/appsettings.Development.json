{
  "Serilog": {
    "ApplicationName": "shipping-worker",
    "ElasticsearchUri": "http://localhost:19200",
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=BuyEZ-Shipping;Port=5432;User Id =postgres;Password=postgres;"
  },
  "JobCronOptions": {
    "FindDriver": "0 * * ? * *",
    "PickUpOrder": "0 */1 * ? * *",
    "DeliverOrder": "0 */1 * ? * *",
    "DeliverOutcome": "0 */2 * ? * *"
  },
  "Kafka": {
    "BootstrapServer": "localhost:29092",
    "Producers": {
      "DeliveryStartedEvent": "delivery-started",
      "DeliverySucceededEvent": "delivery-succeeded"
    },
    "Consumers": {
      "OrderPackedEvent": {
        "Topic": "order-packed",
        "GroupId": "shipping-svc"
      }
    }
  }
}
