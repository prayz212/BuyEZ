{
  "Serilog": {
    "ApplicationName": "order-api",
    "ElasticsearchUri": "http://localhost:19200",
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=BuyEZ-Order;Port=5432;User Id =postgres;Password=postgres;"
  },
  "IdentityOptions": {
    "IssuerUri": "https://localhost:7106"
  },
  "GrpcClientOptions": {
    "Catalog": {
      "ApiKey": "EBhUiAjNsIn92aToaxnNqgZkggeWnR",
      "Address": "https://localhost:7205"
    }
  },
  "Kafka": {
    "BootstrapServer": "localhost:29092",
    "Producers": {
      "OrderCreatedEvent": "order-created",
      "OrderPlacedEvent": "order-placed"
    },
    "Consumers": {
      "OrderPackingStartedEvent": {
        "Topic": "order-packing-started",
        "GroupId": "order-svc"
      },
      "DeliveryStartedEvent": {
        "Topic": "delivery-started",
        "GroupId": "order-svc"
      }
    }
  }
}
